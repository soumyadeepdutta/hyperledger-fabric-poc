# Environment Configuration for Immutable Records API
# Copy this file to .env and modify as needed

# Server Configuration
PORT=3000
NODE_ENV=development

# Fabric Network Configuration
FABRIC_NETWORK_NAME=fabric-network
CHANNEL_NAME=mychannel
CHAINCODE_NAME=immutable-records

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Maximum requests per window

# CORS Configuration
CORS_ORIGIN=*  # In production, specify exact origins

# Security Configuration
HELMET_ENABLED=true
TRUST_PROXY=false

# Database Configuration (if using external database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=immutable_records
# DB_USER=postgres
# DB_PASSWORD=password

# Monitoring Configuration
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# TLS Configuration (for production)
# TLS_ENABLED=false
# TLS_KEY_PATH=/path/to/private-key.pem
# TLS_CERT_PATH=/path/to/certificate.pem

# Fabric Gateway Configuration
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_SSL_TARGET_NAME_OVERRIDE=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP

# Path Configuration (relative to application root)
FABRIC_CRYPTO_PATH=../network/organizations/peerOrganizations/org1.example.com
FABRIC_USER_CERT_PATH=users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_USER_KEY_PATH=users/User1@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=peers/peer0.org1.example.com/tls/ca.crt
FABRIC_ORDERER_TLS_CERT_PATH=../network/organizations/ordererOrganizations/example.com/orderers/orderer.example.com/msp/tlscacerts/tlsca.example.com-cert.pem
